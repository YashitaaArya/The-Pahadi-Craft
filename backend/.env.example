# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pahadicraft?retryWrites=true&w=majority

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# JWT secret used to sign admin login tokens - make this a long random string
JWT_SECRET=

# Server port (Render/Railway set this automatically, but useful for local dev)
PORT=5000

# Optional: allow an extra frontend origin (e.g. a Vercel preview URL) through CORS
EXTRA_CORS_ORIGIN=

# Optional: Twilio (used by Routes/sendNotifications.js for SMS/WhatsApp order confirmations)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
COMPANY_PHONE=

# Used only by scripts/seed.js to create your first admin login
ADMIN_EMAIL=admin@thepahadicraft.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Super Admin
