# Backend API - used by checkout & user-profile calls (no /api suffix, they add it themselves)
VITE_BACKEND_URL=http://localhost:5000

# Backend API - used by the admin dashboard & product store (WITH /api suffix)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay public key (safe to expose client-side)
VITE_RAZORPAY_KEY_ID=

# Firebase (used for customer login/auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_MAINTENANCE_MODE=false