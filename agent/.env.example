# Copy to `.env` and fill in values
ADMIN_ORIGIN=http://localhost:3000
LOGIN_PATH=/admin/login
# Path to the products list (where "Add Product" button lives)
PRODUCTS_PATH=/admin/product
ADD_PRODUCT_PATH=/admin/add-product
# Optional CSS selector to click the Add Product button on the products page.
# Tuned for the React `motion.button` used in the frontend: classes `btn btn-primary`.
# Use this exact value to target the primary Add Product button.
ADD_BUTTON_SELECTOR=button.btn.btn-primary:has-text("Add Product")
ADMIN_USER=admin@example.com
ADMIN_PASS=yourpassword
EXCEL_PATH=products.xlsx
# Set HEADLESS=false if you want to see the browser
HEADLESS=false
